import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int hours;
        float rate;

        // Read input
        hours = sc.nextInt();
        rate = sc.nextFloat();

        // Calculate pay
        float weeklyPay = hours * rate;
        float monthlyPay = (weeklyPay * 52) / 12;
        float annualPay = weeklyPay * 52;

        // Display results
        System.out.printf("Weekly Gross Pay: %.1f\n", weeklyPay);
        System.out.printf("Monthly Gross Pay: %.1f\n", monthlyPay);
        System.out.printf("Annual Gross Pay: %.1f\n", annualPay);

        sc.close();
    }
}
