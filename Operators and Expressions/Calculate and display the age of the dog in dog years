import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int humanAge, dogAge;

        // Read input
        humanAge = sc.nextInt();

        // Calculate dog's age in dog years
        dogAge = humanAge * 7;

        // Display result
        System.out.println(dogAge + " years old in dog years.");

        sc.close();
    }
}
