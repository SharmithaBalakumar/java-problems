import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        int num = input.nextInt();
        int ans = ((num / 100) % 10) * 1 + ((num / 10) % 10) * 10 + ((num / 1) % 10) * 100;
        System.out.println(ans);
    }
}
